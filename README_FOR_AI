## 3. Game template

Start every terminal game from this:

```python
from pypods import Game, PLUS, MINUS, MIDDLE, run, bar, clamp


class MyGame(Game):
    title = "My Game"
    fps = 60
    controls = {
        "left":   [MINUS, "a", "left"],
        "right":  [PLUS, "d", "right"],
        "action": [MIDDLE, "space"],
    }

    def setup(self):
        # runs once: create variables, register callbacks
        self.state = "menu"
        self.reset()

    def reset(self):
        # call this to start or restart a round (never call setup() again)
        self.score = 0
        self.x = 50.0

    def update(self, dt):
        if self.state == "menu":
            if self.action_pressed("action"):
                self.reset()
                self.state = "playing"
        elif self.state == "playing":
            self.x += self.action_axis("left", "right") * 40 * dt
            self.x = clamp(self.x, 0, 100)

    def draw(self):
        if self.state == "menu":
            self.show("MY GAME\n\npress middle (or space) to start")
        else:
            self.show(f"x [{bar(self.x, 100, 30)}]\nscore {self.score}")

    def teardown(self):
        pass  # save high scores here


if __name__ == "__main__":
    run(MyGame)
```

