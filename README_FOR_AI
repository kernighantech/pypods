## 11. Complete example game

"Stop the Needle": a needle sweeps back and forth. Press the middle button to stop it inside the target zone. 10 rounds, faster each round. Shows menu, states, timers, `bar`, `clamp`, `tapped` vs `long_pressed`, `buttons.clear()`, and a saved high score.

```python
import json
import random
from pathlib import Path

from pypods import Game, PLUS, MINUS, MIDDLE, run, bar, clamp

SAVE_FILE = Path(__file__).with_name("needle_best.json")
ROUNDS = 10
WIDTH = 40


class StopTheNeedle(Game):
    title = "Stop the Needle"
    fps = 60
    controls = {
        "less": [MINUS, "a", "left"],
        "more": [PLUS, "d", "right"],
        "go":   [MIDDLE, "space", "enter"],
    }

    # ---------- life cycle ----------

    def setup(self):
        self.best = self.load_best()
        self.difficulty = 3
        self.state = "menu"
        self.reset()

    def reset(self):
        self.round = 0
        self.score = 0
        self.message = ""
        self.new_round()

    def new_round(self):
        self.round += 1
        self.needle = 0.0
        self.direction = 1
        self.speed = (40 + 25 * self.difficulty) * (1.05 ** self.round)
        self.zone = 30 - 4 * self.difficulty
        self.target = random.uniform(20, 80)
        self.result_timer = 0.0

    def teardown(self):
        try:
            SAVE_FILE.write_text(json.dumps({"best": getattr(self, "best", 0)}))
        except OSError:
            pass

    # ---------- logic ----------

    def update(self, dt):
        if self.state == "menu":
            if self.action_pressed("less"):
                self.difficulty = clamp(self.difficulty - 1, 1, 5)
            if self.action_pressed("more"):
                self.difficulty = clamp(self.difficulty + 1, 1, 5)
            if self.action_pressed("go"):
                self.reset()
                self.state = "playing"

        elif self.state == "playing":
            self.needle += self.direction * self.speed * dt
            if self.needle >= 100:
                self.needle, self.direction = 100.0, -1
            elif self.needle <= 0:
                self.needle, self.direction = 0.0, 1

            if self.action_pressed("go"):          # instant: this button has no other job here
                distance = abs(self.needle - self.target)
                points = round(clamp(100 - distance / (self.zone / 2) * 50, 0, 100))
                self.score += points
                self.message = f"+{points} points"
                self.result_timer = 1.0
                self.state = "result"

        elif self.state == "result":
            self.result_timer -= dt
            if self.result_timer <= 0:
                if self.round >= ROUNDS:
                    self.best = max(self.best, self.score)
                    self.buttons.clear()           # drop gestures left over from the last round
                    self.state = "game_over"
                else:
                    self.new_round()
                    self.state = "playing"

        elif self.state == "game_over":
            # tapped + long_pressed on the same button never clash:
            # a tap only counts if released before long_press_time
            if self.action_tapped("go"):
                self.reset()
                self.state = "playing"
            if self.action_long_pressed("go"):
                self.quit()

    # ---------- drawing ----------

    def track(self):
        low = self.target - self.zone / 2
        high = self.target + self.zone / 2
        needle_cell = int(self.needle / 100 * (WIDTH - 1))
        cells = []
        for i in range(WIDTH):
            x = i / (WIDTH - 1) * 100
            if i == needle_cell:
                cells.append("|")
            elif low <= x <= high:
                cells.append("=")
            else:
                cells.append(".")
        return "".join(cells)

    def draw(self):
        if self.state == "menu":
            self.show(
                "STOP THE NEEDLE\n\n"
                f"difficulty [{bar(self.difficulty, 5, 10)}] {self.difficulty}\n\n"
                "minus / plus (or A / D): change difficulty\n"
                "middle (or Space): start\n\n"
                f"best score: {self.best}"
            )
        elif self.state == "game_over":
            self.show(
                "GAME OVER\n\n"
                f"score {self.score}    best {self.best}\n\n"
                "tap middle (or Space): play again\n"
                "long-press middle (or hold Space): quit"
            )
        else:
            hint = self.message if self.state == "result" else "press middle (or Space) to stop the needle"
            self.show(
                f"round {self.round}/{ROUNDS}    score {self.score}    best {self.best}\n\n"
                f"[{self.track()}]\n\n"
                f"{hint}"
            )

    # ---------- saving ----------

    def load_best(self):
        try:
            return int(json.loads(SAVE_FILE.read_text())["best"])
        except (OSError, ValueError, KeyError, TypeError):
            return 0


if __name__ == "__main__":
    game = run(StopTheNeedle)
    print(f"final score: {game.score}")
