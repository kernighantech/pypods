## 7. Recipes

### Press any button to start

```python
if self.state == "menu" and self.buttons.any_pressed():
    self.reset()
    self.state = "playing"
```

### Pause with long press, restart with double tap (callbacks)

```python
controls = {"menu": [MIDDLE, "p"]}

def setup(self):
    self.state = "playing"
    self.on_action("menu", LONG_PRESS, self.toggle_pause)
    self.on_action("menu", DOUBLE_TAP, self.restart)
    self.reset()

def toggle_pause(self):
    self.state = "paused" if self.state == "playing" else "playing"
    self.buttons.clear()          # forget half-finished gestures

def restart(self):
    self.reset()
    self.state = "playing"

def update(self, dt):
    if self.state == "paused":
        return                    # nothing moves while paused
    ...
```

### Charge-up move

```python
def update(self, dt):
    if self.action_held("fire"):
        self.charge = self.action_held_for("fire")
    if self.action_released("fire"):
        self.shoot(power=min(self.charge, 2.0))
        self.charge = 0.0
```

### Smooth movement with two buttons

```python
self.x += self.action_axis("left", "right") * 100 * dt   # 100 units per second
self.x = clamp(self.x, 0, 100)
```

### Lane switching (one step per press)

```python
if self.action_pressed("left"):
    self.lane = max(0, self.lane - 1)
if self.action_pressed("right"):
    self.lane = min(2, self.lane + 1)
```

### Timers and spawning (never `time.sleep`)

```python
self.spawn_timer -= dt
if self.spawn_timer <= 0:
    self.spawn_enemy()
    self.spawn_timer = 1.5
```

### Drawing a row of cells

```python
def draw(self):
    row = ["."] * 20
    row[int(self.x / 100 * 19)] = "@"
    self.show("".join(row) + f"\nscore {self.score}")
```

### Saving a high score

`teardown` runs even after a crash, so don't assume every attribute exists:

```python
import json
from pathlib import Path

SAVE_FILE = Path(__file__).with_name("highscore.json")

def load_best():
    try:
        return int(json.loads(SAVE_FILE.read_text())["best"])
    except (OSError, ValueError, KeyError, TypeError):
        return 0

def teardown(self):
    try:
        SAVE_FILE.write_text(json.dumps({"best": getattr(self, "best", 0)}))
    except OSError:
        pass
```

### Changing controls at run time

```python
self.bind("jump", "w")            # add W to jump
self.unbind("jump", "space")      # remove Space from jump
current = self.bindings()         # dict: action -> buttons
```

### Reading the result after the game

```python
game = run(MyGame)
print("final score:", game.score)
```

